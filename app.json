{
  "expo": {
    "name": "SinalSeguro",
    "slug": "sinalseguro-app",
    "scheme": "sinalseguro",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/sinalseguro-icon.png",
    "splash": {
      "image": "./assets/brand/sinalseguro-splash-approved.png",
      "resizeMode": "contain",
      "backgroundColor": "#120A20"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.sinalseguro.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O SinalSeguro usa sua localizacao apenas quando voce autoriza o envio em um alerta."
      }
    },
    "android": {
      "package": "br.com.sinalseguro.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/sinalseguro-icon.png",
        "backgroundColor": "#1E1B2E"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "./plugins/with-android-debug-permission-hardening",
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "O SinalSeguro usa a camera somente quando voce aciona o SOS e autoriza a gravacao local de emergencia.",
          "microphonePermission": "O SinalSeguro usa o microfone somente quando voce aciona o SOS e autoriza a gravacao local de emergencia.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O SinalSeguro usa sua localizacao apenas para anexar o ponto do chamado quando voce autorizar.",
          "locationAlwaysAndWhenInUsePermission": "O SinalSeguro pode usar localizacao em segundo plano somente em homologacao autorizada, com consentimento e notificacao persistente.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "minSdkVersion": 24,
            "targetSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
