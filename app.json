{
  "expo": {
    "name": "SinalSeguro",
    "slug": "sinalseguro-app",
    "scheme": "sinalseguro",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.sinalseguro.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O SinalSeguro usa sua localizacao apenas quando voce autoriza o envio em um alerta."
      }
    },
    "android": {
      "package": "br.com.sinalseguro.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-location",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "minSdkVersion": 24,
            "targetSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
