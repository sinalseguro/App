+from rest_framework import generics, response, viewsets
+
+from audit.models import AuditEvent
+from audit.services import record_audit_event
+
+from .models import ProfileAuthorization, ProtectedSubject, ResponsibleLink
+from .policies import get_or_create_user_profile
+from .serializers import (
+    ProfileAuthorizationSerializer,
+    ProtectedSubjectSerializer,
+    ResponsibleLinkSerializer,
+    UserProfileSerializer,
+)
+
+
+class CurrentUserProfileView(generics.GenericAPIView):
+    serializer_class = UserProfileSerializer
+
+    def get(self, request):
+        profile = get_or_create_user_profile(request.user)
+        return response.Response(self.get_serializer(profile).data)
+
+    def patch(self, request):
+        profile = get_or_create_user_profile(request.user)
+        serializer = self.get_serializer(profile, data=request.data, partial=True)
+        serializer.is_valid(raise_exception=True)
+        profile = serializer.save()
+        record_audit_event(
+            request=request,
+            category=AuditEvent.Category.CONSENT,
+            action="profile_update",
+            object_type="profiles.UserProfile",
+            object_id=profile.id,
+            metadata={"kind": profile.kind, "policy_version": profile.policy_version},
+        )
+        return response.Response(serializer.data)
+
+
+class ProtectedSubjectViewSet(viewsets.ModelViewSet):
+    queryset = ProtectedSubject.objects.none()
+    serializer_class = ProtectedSubjectSerializer
+    http_method_names = ["get", "post", "patch", "head", "options"]
+    filterset_fields = ["status"]
+    search_fields = ["display_label"]
+
+    def get_queryset(self):
+        return ProtectedSubject.objects.filter(guardian=self.request.user).order_by("display_label")
+
+
+class ResponsibleLinkViewSet(viewsets.ModelViewSet):
+    queryset = ResponsibleLink.objects.none()
+    serializer_class = ResponsibleLinkSerializer
+    http_method_names = ["get", "post", "patch", "head", "options"]
+    filterset_fields = ["status"]
+
+    def get_queryset(self):
+        return ResponsibleLink.objects.filter(responsible=self.request.user).order_by("-created_at")
+
+
+class ProfileAuthorizationViewSet(viewsets.ModelViewSet):
+    queryset = ProfileAuthorization.objects.none()
+    serializer_class = ProfileAuthorizationSerializer
+    http_method_names = ["get", "post", "patch", "head", "options"]
+    filterset_fields = ["scope", "status"]
+
+    def get_queryset(self):
+        return ProfileAuthorization.objects.filter(responsible_link__responsible=self.request.user).order_by("-created_at")
