+from dataclasses import dataclass
+
+from django.db.models import Q
+from django.utils import timezone
+
+from .models import ProfileAuthorization, ProtectedSubject, ResponsibleLink, UserProfile
+
+
+MOBILE_TO_API_KIND = {
+    "adult_self_managed": UserProfile.Kind.ADULT_SELF,
+    "minor_protected": UserProfile.Kind.MINOR_PROTECTED,
+    "responsible_without_minor": UserProfile.Kind.GUARDIAN_WITHOUT_MINOR,
+    "responsible_with_minor": UserProfile.Kind.GUARDIAN,
+}
+
+API_TO_MOBILE_KIND = {value: key for key, value in MOBILE_TO_API_KIND.items()}
+
+
+@dataclass(frozen=True)
+class GateDecision:
+    allowed: bool
+    code: str
+    message: str
+
+
+def normalize_profile_kind(kind: str) -> str:
+    return MOBILE_TO_API_KIND.get(kind, kind)
+
+
+def get_user_profile(user) -> UserProfile | None:
+    return UserProfile.objects.filter(user=user).first()
+
+
+def get_or_create_user_profile(user) -> UserProfile:
+    profile, _created = UserProfile.objects.get_or_create(user=user)
+    return profile
+
+
+def has_active_minor_authorization(user, protected_subject: ProtectedSubject | None = None) -> bool:
+    now = timezone.now()
+    queryset = ProfileAuthorization.objects.filter(
+        responsible_link__responsible=user,
+        responsible_link__status=ResponsibleLink.Status.ACTIVE,
+        responsible_link__protected_subject__status=ProtectedSubject.Status.ACTIVE,
+        scope=ProfileAuthorization.Scope.TRUSTED_CONTACT_NETWORK,
+        status=ProfileAuthorization.Status.ACTIVE,
+    ).filter(Q(expires_at__isnull=True) | Q(expires_at__gt=now))
+    if protected_subject is not None:
+        queryset = queryset.filter(responsible_link__protected_subject=protected_subject)
+    return queryset.exists()
+
+
+def can_create_trusted_contact(user, protected_subject: ProtectedSubject | None = None) -> GateDecision:
+    profile = get_user_profile(user)
+    if not profile or profile.status != UserProfile.Status.ACTIVE or profile.kind == UserProfile.Kind.UNKNOWN:
+        return GateDecision(False, "profile_missing", "Configure o perfil antes de criar convites.")
+    if profile.kind == UserProfile.Kind.ADULT_SELF:
+        if protected_subject is not None:
+            return GateDecision(False, "adult_subject_forbidden", "Adulto para si nao vincula protegido menor.")
+        return GateDecision(True, "adult_self_allowed", "Adulto protegido autorizado para rede propria.")
+    if profile.kind == UserProfile.Kind.MINOR_PROTECTED:
+        return GateDecision(False, "minor_cannot_invite", "Menor protegido nao cria convites.")
+    if profile.kind == UserProfile.Kind.GUARDIAN_WITHOUT_MINOR:
+        return GateDecision(False, "guardian_minor_missing", "Responsavel precisa de protegido menor ativo.")
+    if profile.kind == UserProfile.Kind.GUARDIAN and has_active_minor_authorization(user, protected_subject):
+        return GateDecision(True, "guardian_minor_authorized", "Responsavel autorizado para rede do menor.")
+    return GateDecision(False, "guardian_authorization_missing", "Responsavel precisa de vinculo e autorizacao ativos.")
+
+
+def can_accept_angel_invitation(user) -> GateDecision:
+    profile = get_user_profile(user)
+    if not profile or profile.status != UserProfile.Status.ACTIVE or profile.kind == UserProfile.Kind.UNKNOWN:
+        return GateDecision(False, "profile_missing", "Configure o perfil adulto antes de aceitar convite.")
+    if profile.kind == UserProfile.Kind.MINOR_PROTECTED:
+        return GateDecision(False, "minor_cannot_act_as_angel", "Menor protegido nao pode atuar como anjo.")
+    return GateDecision(True, "adult_can_accept", "Adulto com conta propria pode aceitar convite.")
