+from django.utils import timezone
+from rest_framework import serializers
+
+from .models import PROFILE_POLICY_VERSION, ProfileAuthorization, ProtectedSubject, ResponsibleLink, UserProfile
+from .policies import normalize_profile_kind
+
+
+SENSITIVE_EVIDENCE_KEYS = {
+    "address",
+    "birth_date",
+    "bo",
+    "cpf",
+    "document",
+    "document_number",
+    "full_birth_date",
+    "full_name",
+    "legal_name",
+    "location",
+    "media",
+    "nascimento",
+    "relato",
+    "rg",
+    "school",
+    "selfie",
+    "violence_report",
+}
+
+
+def validate_minimized_evidence(value):
+    if value in (None, ""):
+        return {}
+    if not isinstance(value, dict):
+        raise serializers.ValidationError("Evidencia precisa ser objeto simples.")
+    normalized_keys = {str(key).strip().lower() for key in value.keys()}
+    if normalized_keys & SENSITIVE_EVIDENCE_KEYS:
+        raise serializers.ValidationError("Evidencia contem dados sensiveis fora do escopo desta frente.")
+    return value
+
+
+class UserProfileSerializer(serializers.ModelSerializer):
+    kind = serializers.CharField()
+
+    class Meta:
+        model = UserProfile
+        fields = ["id", "kind", "status", "policy_version", "configured_at", "updated_at"]
+        read_only_fields = ["id", "status", "policy_version", "configured_at", "updated_at"]
+
+    def validate_kind(self, value):
+        normalized = normalize_profile_kind(value)
+        allowed = {choice[0] for choice in UserProfile.Kind.choices}
+        if normalized not in allowed:
+            raise serializers.ValidationError("Perfil indisponivel.")
+        return normalized
+
+    def update(self, instance, validated_data):
+        instance.kind = validated_data.get("kind", instance.kind)
+        instance.status = UserProfile.Status.ACTIVE
+        instance.policy_version = PROFILE_POLICY_VERSION
+        instance.save(update_fields=["kind", "status", "policy_version", "updated_at"])
+        return instance
+
+
+class ProtectedSubjectSerializer(serializers.ModelSerializer):
+    class Meta:
+        model = ProtectedSubject
+        fields = ["id", "display_label", "status", "policy_version", "created_at", "updated_at"]
+        read_only_fields = ["id", "policy_version", "created_at", "updated_at"]
+
+    def validate_display_label(self, value):
+        label = value.strip()
+        if not label:
+            raise serializers.ValidationError("Informe um apelido operacional do protegido.")
+        return label
+
+    def create(self, validated_data):
+        return ProtectedSubject.objects.create(guardian=self.context["request"].user, **validated_data)
+
+
+class ResponsibleLinkSerializer(serializers.ModelSerializer):
+    class Meta:
+        model = ResponsibleLink
+        fields = ["id", "protected_subject", "status", "policy_version", "created_at", "updated_at", "revoked_at"]
+        read_only_fields = ["id", "policy_version", "created_at", "updated_at", "revoked_at"]
+
+    def validate_protected_subject(self, value):
+        if value.guardian != self.context["request"].user:
+            raise serializers.ValidationError("Protegido indisponivel para esta conta.")
+        return value
+
+    def create(self, validated_data):
+        return ResponsibleLink.objects.create(responsible=self.context["request"].user, **validated_data)
+
+
+class ProfileAuthorizationSerializer(serializers.ModelSerializer):
+    class Meta:
+        model = ProfileAuthorization
+        fields = [
+            "id",
+            "responsible_link",
+            "scope",
+            "status",
+            "version",
+            "evidence",
+            "expires_at",
+            "created_at",
+            "updated_at",
+            "revoked_at",
+        ]
+        read_only_fields = ["id", "version", "created_at", "updated_at", "revoked_at"]
+
+    def validate_responsible_link(self, value):
+        if value.responsible != self.context["request"].user:
+            raise serializers.ValidationError("Vinculo indisponivel para esta conta.")
+        return value
+
+    def validate_evidence(self, value):
+        return validate_minimized_evidence(value)
+
+    def validate(self, attrs):
+        expires_at = attrs.get("expires_at")
+        if expires_at and expires_at <= timezone.now():
+            raise serializers.ValidationError("Autorizacao nao pode nascer expirada.")
+        return attrs
