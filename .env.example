# Configuracao publica do app Expo. Nao colocar segredos neste arquivo.

EXPO_PUBLIC_SINALSEGURO_API_BASE_URL=https://api.sinalseguro.com.br/api
EXPO_PUBLIC_SINALSEGURO_API_ENABLED=1

# Builds iOS com Apple Sign-In/Push exigem Apple Developer Program pago e capabilities no Bundle ID.
# Manter 0 para builds USB com Personal Team gratuito.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=0
EXPO_PUBLIC_IOS_PUSH_ENABLED=0

# OIDC Google do APK Android privado.
# Criar/manter OAuth Client ID do tipo Android no Google Cloud para:
# package: br.com.sinalseguro.app
# SHA-1 debug/private APK local: 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
# O Android usa Google Sign-In nativo e envia para a API um ID token com aud do Web Client ID.
EXPO_PUBLIC_GOOGLE_OIDC_ANDROID_CLIENT_ID=

# Google iOS exige um OAuth Client ID do tipo iOS no Google Cloud:
# bundle id: br.com.sinalseguro.app
EXPO_PUBLIC_GOOGLE_OIDC_IOS_CLIENT_ID=
# Obrigatorio somente no build iOS nativo com Google Sign-In.
EXPO_PUBLIC_GOOGLE_OIDC_IOS_URL_SCHEME=

# OAuth Client ID do tipo Web, usado localmente pelo Google Sign-In nativo para obter ID token.
EXPO_PUBLIC_GOOGLE_OIDC_WEB_CLIENT_ID=
