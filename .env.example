# Configuracao publica do app Expo. Nao colocar segredos neste arquivo.

EXPO_PUBLIC_SINALSEGURO_API_BASE_URL=https://api.sinalseguro.com.br/api
EXPO_PUBLIC_SINALSEGURO_API_ENABLED=1

# OIDC Google do APK Android privado.
# Preencher com o OAuth Client ID do tipo Android criado no Google Cloud para:
# package: br.com.sinalseguro.app
# SHA-1 debug/private APK local: 5E:8F:16:06:2E:A3:CD:2C:4A:0D:54:78:76:BA:A6:F3:8C:AB:F6:25
EXPO_PUBLIC_GOOGLE_OIDC_ANDROID_CLIENT_ID=

# Reservado para etapas futuras, quando web/iOS forem habilitados.
EXPO_PUBLIC_GOOGLE_OIDC_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OIDC_IOS_CLIENT_ID=
