{
  "name": "sinalseguro-app",
  "version": "0.1.5",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prepare:build:ios": "node ../../scripts/prepare-platform-build.mjs ios",
    "prepare:build:ios:secure-config": "node scripts/prepare-ios-secure-build-config.mjs",
    "prepare:build:android": "node ../../scripts/prepare-platform-build.mjs android",
    "patch:ios:path-spaces": "node ../../scripts/patch-ios-pods-path-spaces.mjs",
    "postprocess:ios:release": "node ../../scripts/postprocess-ios-release-app.mjs",
    "web": "expo start --web",
    "doctor": "npx expo-doctor@latest",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node scripts/lint-check.mjs",
    "test": "node scripts/smoke-test.mjs && npm run test:crypto && npm run test:device-keys && npm run test:profiles",
    "test:crypto": "tsx scripts/encrypted-video-store.test.ts",
    "test:device-keys": "tsx scripts/device-key-proof.test.ts",
    "test:profiles": "tsx scripts/profile-policy.test.ts",
    "assets:qr": "node scripts/generate-qr-assets.mjs",
    "release:android:readiness": "node scripts/android-release-readiness.mjs",
    "private:android:readiness": "node scripts/android-private-media-readiness.mjs",
    "build:android:private": "npm run build:android:debug:bundled",
    "build:android:debug:bundled": "node scripts/prepare-android-bundled-debug.mjs && cd android && ./gradlew assembleDebug -PsinalBundleDebugJs=true",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "build:android:preview:local": "npx eas-cli@latest build --platform android --profile preview --local"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@tanstack/react-query": "^5.90.7",
    "ajv": "^8.20.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.21",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.7",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.8",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.14",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.553.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tcp-socket": "^6.4.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "https-proxy-agent": "^7.0.5",
    "metro": "0.83.3",
    "metro-core": "^0.83.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
